import random
playing = True
number= random.randint(0,9)
print("I will generate a number from 0 to 9 and you have to guess the number 1 digit at a time")
print("The game ends when you find the correct number")
while playing:
    guess = int(input("Give me your best guess "))
    if number == guess:
        print("You win the game")
        print("The number was ", number)
        break
    else:
        print(" Try again")
        
            


